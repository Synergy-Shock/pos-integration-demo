# Copiá este archivo a .env y completá los valores. El .env nunca se sube al repo.
# Sin MORSIS_API_KEY la app arranca en MODO DEMO, con un Morsis simulado en memoria.

# Clave de la API pública de Morsis (Integraciones > API pública). Solo vive en el servidor.
MORSIS_API_KEY=

# Producción: https://api.morsis.com/v1   ·   Staging: https://api-staging.morsis.com/v1
MORSIS_BASE_URL=https://api-staging.morsis.com/v1

# Sucursal donde se presentan los cupones (opcional: si no está, se elige en pantalla).
MORSIS_BRANCH_ID=

# Usuario de Morsis creado para el operador del sistema externo (actorUserId).
MORSIS_ACTOR_USER_ID=

# Identificador de la caja/terminal de tu sistema (externalDeviceId).
EXTERNAL_DEVICE_ID=CAJA-1

# Datos fiscales de quien factura (tu empresa). Se informan a Morsis en la factura externa.
INVOICE_ISSUER_TAX_ID=30712345678
INVOICE_ISSUER_NAME=Empresa externa SA
INVOICE_TYPE_CODE=6
INVOICE_POINT_OF_SALE=1

PORT=3000
# 127.0.0.1 = solo accesible desde esta máquina (recomendado: la pantalla permite pegar una API key).
HOST=127.0.0.1
